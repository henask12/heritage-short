# Copy this file to .env and fill in your own keys. NEVER commit .env to git.

# Required for Gemini Flash (script refinement) and Gemini TTS (English + Amharic narration)
GEMINI_API_KEY=

# Required in Phase 2 for FLUX keyframe generation via Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional in Phase 2 for Kaggle notebook automation (Wan 2.2 TI2V-5B + ACE-Step 1.5)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional override for narration voice or model
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Comma-separated fallbacks tried automatically on HTTP 429/503/404 (after preferred model)
# GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon
