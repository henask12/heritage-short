{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/henask12/heritage-short/schema/storyboard.schema.json",
  "title": "Heritage Short Storyboard Contract",
  "description": "Single source of truth contract validated before every pipeline stage in Red Through the Years.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "style",
    "characters",
    "audio",
    "subtitles",
    "end_card",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "slug",
        "logline",
        "audience",
        "intent",
        "primary_language",
        "secondary_languages",
        "target_duration_sec",
        "aspect_ratios",
        "fps"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "logline": { "type": "string", "minLength": 20, "maxLength": 300 },
        "audience": { "type": "string", "minLength": 10, "maxLength": 300 },
        "intent": { "type": "string", "minLength": 10, "maxLength": 300 },
        "primary_language": { "type": "string", "enum": ["en"] },
        "secondary_languages": {
          "type": "array",
          "items": { "type": "string", "enum": ["am", "en"] }
        },
        "target_duration_sec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 60, "maximum": 90 },
            "max": { "type": "number", "minimum": 60, "maximum": 90 }
          }
        },
        "aspect_ratios": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["16:9", "9:16"] }
        },
        "fps": { "type": "integer", "enum": [24, 25, 30] }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_direction",
        "color_palette",
        "lighting",
        "lens_and_texture",
        "prompt_suffix",
        "negative_prompt",
        "likeness_guardrails"
      ],
      "properties": {
        "visual_direction": { "type": "string", "minLength": 20 },
        "color_palette": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 3 }
        },
        "lighting": { "type": "string", "minLength": 10 },
        "lens_and_texture": { "type": "string", "minLength": 10 },
        "prompt_suffix": { "type": "string", "minLength": 10 },
        "negative_prompt": { "type": "string", "minLength": 10 },
        "likeness_guardrails": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "role",
          "age_range",
          "consent_status",
          "reference_image",
          "physical_description",
          "wardrobe_anchor"
        ],
        "properties": {
          "display_name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 3 },
          "age_range": { "type": "string", "minLength": 3 },
          "consent_status": {
            "type": "string",
            "enum": ["consented_owner", "stylized_derived_from_consented_owner", "synthetic_anonymous"]
          },
          "reference_image": { "type": ["string", "null"] },
          "physical_description": { "type": "string", "minLength": 20 },
          "wardrobe_anchor": { "type": "string", "minLength": 10 },
          "consistency_notes": { "type": "string" }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration", "music", "mix"],
      "properties": {
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "voice_name", "voice_type", "style_prompt", "sample_rate_hz"],
          "properties": {
            "provider": { "type": "string", "enum": ["gemini-tts"] },
            "model": { "type": "string", "minLength": 3 },
            "voice_name": { "type": "string", "minLength": 2 },
            "voice_type": { "type": "string", "enum": ["stock_prebuilt"] },
            "style_prompt": { "type": "string", "minLength": 10 },
            "sample_rate_hz": { "type": "integer", "enum": [24000, 44100, 48000] }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "global_prompt", "key_signature", "bpm", "placeholder_mode"],
          "properties": {
            "provider": { "type": "string", "enum": ["ace-step", "placeholder-synth"] },
            "model": { "type": "string", "minLength": 3 },
            "global_prompt": { "type": "string", "minLength": 15 },
            "key_signature": { "type": "string", "minLength": 2 },
            "bpm": { "type": "integer", "minimum": 50, "maximum": 140 },
            "placeholder_mode": { "type": "string", "enum": ["warm_ambient_pad", "silence"] }
          }
        },
        "mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_lufs", "true_peak_dbtp", "music_base_gain_db", "music_ducked_gain_db"],
          "properties": {
            "target_lufs": { "type": "number", "minimum": -20, "maximum": -10 },
            "true_peak_dbtp": { "type": "number", "minimum": -3, "maximum": 0 },
            "music_base_gain_db": { "type": "number", "minimum": -30, "maximum": 0 },
            "music_ducked_gain_db": { "type": "number", "minimum": -40, "maximum": -6 }
          }
        }
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burned_in", "language", "font_name", "font_size"],
      "properties": {
        "burned_in": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en"] },
        "font_name": { "type": "string", "minLength": 2 },
        "font_size": { "type": "integer", "minimum": 14, "maximum": 48 }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "title", "credit", "ai_disclosure", "consent_notice"],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^shot_[0-9]{2}$" },
        "title": { "type": "string", "minLength": 2 },
        "credit": { "type": "string", "minLength": 5 },
        "ai_disclosure": { "type": "string", "minLength": 20 },
        "consent_notice": { "type": "string", "minLength": 10 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "beat_title",
          "era",
          "shot_type",
          "duration_sec",
          "characters",
          "camera",
          "image_prompt",
          "motion_prompt",
          "narration",
          "music_cue",
          "reason",
          "seed",
          "motion_strategy"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^shot_[0-9]{2}$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 12 },
          "beat_title": { "type": "string", "minLength": 3, "maxLength": 80 },
          "era": { "type": "string", "minLength": 3, "maxLength": 80 },
          "shot_type": { "type": "string", "enum": ["narrative", "end_card"] },
          "duration_sec": { "type": "number", "minimum": 4.0, "maximum": 12.0 },
          "characters": {
            "type": "array",
            "items": { "type": "string" }
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framing", "movement"],
            "properties": {
              "framing": { "type": "string", "minLength": 3 },
              "movement": { "type": "string", "minLength": 3 }
            }
          },
          "image_prompt": { "type": "string", "minLength": 30 },
          "motion_prompt": { "type": "string", "minLength": 15 },
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en"],
            "properties": {
              "en": { "type": "string" },
              "am": { "type": "string" }
            }
          },
          "music_cue": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mood", "instrumentation", "intensity"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "mood": { "type": "string", "minLength": 3 },
              "instrumentation": { "type": "string", "minLength": 5 },
              "intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          },
          "reason": { "type": "string", "minLength": 20 },
          "seed": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "motion_strategy": { "type": "string", "enum": ["wan_i2v", "ken_burns", "static_card"] }
        }
      }
    }
  }
}
